# Copy this file to .env and replace every placeholder locally.
# Never commit .env or real credentials.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=starmap

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=10080

# Email SMTP (example: QQ Mail)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password

# Map provider
AMAP_KEY=your_amap_api_key

# CORS allowed frontend origin
FRONTEND_ORIGIN=http://localhost:5500

# Optional Alibaba Cloud visual AI service
ALI_AK_ID=your_access_key_id
ALI_AK_SECRET=your_access_key_secret

# Optional Resend email API
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Your App <onboarding@resend.dev>
